<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yellow_alpha" />
            <stroke android:width="1dp" android:color="@color/yellow_neon" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/retro_black" />
            <stroke android:width="0.5dp" android:color="@color/galaxy_black" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>